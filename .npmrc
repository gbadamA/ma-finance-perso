# node_modules a PLAT (pas d'arborescence .pnpm/<pkg>@<version>_<hash>/node_modules/).
#
# ⚠️ Indispensable pour compiler l'APK sous Windows : CMake refuse un chemin
# d'objet de plus de 250 caracteres (CMAKE_OBJECT_PATH_MAX), et le prefixe
# `.pnpm/react-native-screens@4.26.2_6c049f18.../node_modules/` en ajoute ~78 a
# lui seul. Le build echoue sur « ninja: error: manifest 'build.ninja' still
# dirty after 100 tries ».
node-linker=hoisted
