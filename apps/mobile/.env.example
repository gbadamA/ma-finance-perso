# URL de l'API NestJS, SANS barre finale et SANS le préfixe /api
# (le client l'ajoute lui-même). Copier ce fichier en .env.
#
#   local (émulateur Android) : http://10.0.2.2:3000
#   local (téléphone en LAN)  : http://192.168.x.x:3000
#   production                : https://ma-finance-perso-api.onrender.com
#
# Laisser vide fait démarrer l'app en mode démonstration.
EXPO_PUBLIC_API_URL=
