{
  "expo": {
    "name": "Ma Finance Perso",
    "slug": "ma-finance-perso",
    "scheme": "mafinanceperso",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-itekt.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070C1E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ci.itekt.mafinanceperso"
    },
    "android": {
      "package": "ci.itekt.mafinanceperso",
      "adaptiveIcon": {
        "backgroundColor": "#0C1740",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1740",
          "image": "./assets/images/logo-itekt.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser Ma Finance Perso a deverrouiller l'application avec Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Ma Finance Perso a joindre une photo de recu depuis vos images.",
          "cameraPermission": "Autoriser Ma Finance Perso a photographier vos recus."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2994A",
          "defaultChannel": "finance"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "apiUrl": "https://ma-finance-perso-api.onrender.com"
    }
  }
}
