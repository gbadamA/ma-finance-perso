# Base Neon — onglet Connect du projet, chaine "Pooled connection".
# ⚠️ Prendre la version POOLED : Render ouvre plusieurs instances, une connexion
# directe epuiserait vite le quota de connexions de Neon.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret de signature des JWT — 32 caracteres minimum, sinon l'API refuse de demarrer.
# Generer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Render fournit PORT automatiquement ; utile en local seulement.
PORT=3000
