{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Ma Finance Perso — remplace Supabase (Auth + PostgREST + Storage) devant une base Neon.",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "verify": "node test/verification.mjs && node test/verification-recus.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.23.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "7.10.0",
    "typescript": "^5.9.2",
    "@types/pg": "^8.23.1",
    "@types/multer": "^2.0.0"
  }
}
